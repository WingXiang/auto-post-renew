# =============================================
# 這份檔案只放「變數名稱」當範本，永遠不要填真實值
# 真實值請填到 .env.local（已被 .gitignore 排除）
# 正式環境請設在 Vercel / Zeabur 的環境變數介面
# =============================================

# --- Clerk (Auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Google Sheets (Service Account) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 多行 PEM 需要用 "\n" 編碼；前後加雙引號
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- n8n ---
N8N_BASE_URL=
# 與 n8n 主機 + worker 上的 N8N_API_KEY 必須完全相同
N8N_API_KEY=

# --- LLM ---
# 主要文案 / 圖片生成皆使用 Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# 若仍有舊流程仰賴 Anthropic（email 產生器）
ANTHROPIC_API_KEY=

# --- 搜尋（topic-discovery）---
SERPER_API_KEY=

# --- imgbb（AI 產圖上傳）---
IMGBB_API_KEY=

# --- Vercel Blob（圖片儲存）---
BLOB_READ_WRITE_TOKEN=
# 可選：Blob Store 識別碼，僅供腳本參考
BLOB_STORE_ID=

# --- 本機開發專用（不要設到正式環境）---
# 跳過 Clerk 驗證以方便本機測試。Vercel production 絕對不可開啟
DEV_BYPASS_AUTH=
# 跳過驗證時預設用哪個 orgId 模擬登入
DEV_DEFAULT_BRAND_ID=
