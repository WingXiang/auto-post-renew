              "name": "access_token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a5000001-0000-0000-0000-000000000009",
      "name": "IG 數據 API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const brandId = $('驗證請求').first().json.brand_id;\nconst items = $input.all();\nconst now = new Date().toISOString();\n\nreturn items.map((item, i) => {\n  const data = item.json;\n  const likes = data.likes?.summary?.total_count || data.data?.[0]?.values?.[0]?.value || 0;\n  const comments = data.comments?.summary?.total_count || data.data?.[1]?.values?.[0]?.value || 0;\n  const shares = data.shares?.count || data.data?.[2]?.values?.[0]?.value || 0;\n  const reach = data.insights?.data?.[0]?.values?.[0]?.value || data.data?.[3]?.values?.[0]?.value || 0;\n  const totalInteractions = likes + comments + shares;\n  const engagementRate = reach > 0 ? ((totalInteractions / reach) * 100).toFixed(2) : '0';\n\n  return {\n    json: {\n      analytics_id: `ana-${Date.now()}-${i}`,\n      brand_id: brandId,\n      post_id: $('展開貼文清單').all()[i]?.json?.post_id || '',\n      platform: $('展開貼文清單').all()[i]?.json?.platform || '',\n      likes: String(likes),\n      comments: String(comments),\n      shares: String(shares),\n      reach: String(reach),\n      engagement_rate: engagementRate,\n      collected_at: now\n    }\n  };\n});"
      },
