    {
      "parameters": {
        "jsCode": "const brand = $('讀取品牌').first().json;\nconst posts = $('讀取已發佈貼文').all().map(i => i.json);\n\nif (!brand.meta_access_token) {\n  throw new Error('品牌尚未設定 Meta Access Token');\n}\n\nconst results = [];\nfor (const post of posts) {\n  if (post.fb_post_id) {\n    results.push({\n      post_id: post.post_id,\n      platform_post_id: post.fb_post_id,\n      platform: 'facebook',\n      access_token: brand.meta_access_token\n    });\n  }\n  if (post.ig_post_id) {\n    results.push({\n      post_id: post.post_id,\n      platform_post_id: post.ig_post_id,\n      platform: 'instagram',\n      access_token: brand.meta_access_token\n    });\n  }\n}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "a5000001-0000-0000-0000-000000000006",
      "name": "展開貼文清單",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.platform }}",
              "rightValue": "facebook",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "a5000001-0000-0000-0000-000000000007",
      "name": "平台判斷",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1420,
        300
