      "parameters": {
        "jsCode": "const apiKey = $input.first().json.body.api_key;\nif (!apiKey || apiKey !== $env.N8N_API_KEY) {\n  throw new Error('Unauthorized');\n}\nconst { brand_id, post_id } = $input.first().json.body;\nif (!brand_id || !post_id) throw new Error('Missing brand_id or post_id');\n\nreturn [{\n  json: {\n    brand_id,\n    post_id,\n    log_id: 'ps-' + $now.toISO().replace(/[^0-9]/g, '').slice(0, 17),\n    started_at: $now.toISO()\n  }\n}];"
