      "parameters": {
        "jsCode": "// Safely read FB / IG results — they may not have executed\nconst postId = $('驗證請求').first().json.post_id;\nlet fbResult = null;\nlet igResult = null;\ntry { fbResult = $('發佈 Facebook').first()?.json; } catch (e) {}\ntry { igResult = $('發佈 IG 媒體').first()?.json; } catch (e) {}\nreturn [{\n  json: {\n    post_id: postId,\n    status: 'published',\n    fb_post_id: fbResult?.id || fbResult?.post_id || '',\n    ig_post_id: igResult?.id || ''\n  }\n}];"
