{
  "name": "post-scheduler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "post-scheduler",
        "options": {},
        "responseMode": "responseNode"
      },
      "id": "a4000001-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "post-scheduler"
    },
    {
      "parameters": {
        "jsCode": "const apiKey = $input.first().json.api_key;\nif (!apiKey || apiKey !== $env.N8N_API_KEY) {\n  throw new Error('Unauthorized');\n}\nconst { brand_id, post_id } = $input.first().json;\nif (!brand_id || !post_id) throw new Error('Missing brand_id or post_id');\n\nreturn [{\n  json: {\n    brand_id,\n    post_id,\n    log_id: 'ps-' + $now.toISO().replace(/[^0-9]/g, '').slice(0, 17),\n    started_at: $now.toISO()\n  }\n}];"
      },
      "id": "a4000001-0000-0000-0000-000000000002",
      "name": "驗證請求",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "pipeline_logs"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "log_id": "={{ $json.log_id }}",
            "brand_id": "={{ $json.brand_id }}",
            "workflow_name": "post-scheduler",
            "status": "running",
            "message": "發佈貼文中...",
            "started_at": "={{ $json.started_at }}",
            "finished_at": ""
          }
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000003",
      "name": "記錄開始",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}"
        },
        "sheetName": {
