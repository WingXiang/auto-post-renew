          "value": "posts"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "post_id": "={{ $json.post_id }}",
            "status": "published",
            "fb_post_id": "={{ $json.fb_post_id }}",
            "ig_post_id": "={{ $json.ig_post_id }}"
          }
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000013",
