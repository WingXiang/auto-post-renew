          "mode": "list",
          "value": "brands"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "brand_id",
              "lookupValue": "={{ $('驗證請求').first().json.brand_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000004",
      "name": "讀取品牌",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        900,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "posts"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "post_id",
              "lookupValue": "={{ $('驗證請求').first().json.post_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000005",
      "name": "讀取貼文",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        900,
        420
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const brand = $('讀取品牌').first().json;\nconst post = $('讀取貼文').first().json;\n\nif (!brand.meta_access_token) {\n  throw new Error('品牌尚未設定 Meta Access Token，無法發佈');\n}\nif (!post.caption) {\n  throw new Error('貼文缺少文案內容');\n}\n\nconst platform = post.platform || 'both';\nconst publishFB = platform === 'facebook' || platform === 'both';\nconst publishIG = platform === 'instagram' || platform === 'both';\n\nreturn [{\n  json: {\n    ...post,\n    access_token: brand.meta_access_token,\n    fb_page_id: brand.fb_page_id,\n    ig_account_id: brand.ig_account_id,\n    publishFB,\n    publishIG\n  }\n}];"
      },
      "id": "a4000001-0000-0000-0000-000000000006",
      "name": "準備發佈資料",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{ $json.publishFB }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "a4000001-0000-0000-0000-000000000007",
      "name": "發佈到 Facebook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1420,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.fb_page_id }}/feed",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000008",
      "name": "發佈 Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{ $('準備發佈資料').first().json.publishIG }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "a4000001-0000-0000-0000-000000000009",
      "name": "發佈到 Instagram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1420,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('準備發佈資料').first().json.ig_account_id }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "caption",
              "value": "={{ $('準備發佈資料').first().json.caption }}"
            },
            {
              "name": "image_url",
              "value": "={{ $('準備發佈資料').first().json.image_url }}"
            },
            {
              "name": "access_token",
              "value": "={{ $('準備發佈資料').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000010",
      "name": "建立 IG 媒體容器",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('準備發佈資料').first().json.ig_account_id }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $('準備發佈資料').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a4000001-0000-0000-0000-000000000011",
      "name": "發佈 IG 媒體",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const postId = $('驗證請求').first().json.post_id;\nconst fbResult = $('發佈 Facebook').first()?.json;\nconst igResult = $('發佈 IG 媒體').first()?.json;\n\nreturn [{\n  json: {\n    post_id: postId,\n    status: 'published',\n    fb_post_id: fbResult?.id || '',\n    ig_post_id: igResult?.id || ''\n  }\n}];"
      },
      "id": "a4000001-0000-0000-0000-000000000012",
      "name": "合併結果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}"
        },
        "sheetName": {
