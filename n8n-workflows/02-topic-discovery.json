    {
      "parameters": {
        "jsCode": "const brand = $input.first().json;\nconst theme = brand.theme || '社群行銷';\nconst audience = brand.target_audience || '一般消費者';\n\n// 組合搜尋關鍵字\nconst queries = [\n  `${theme} 趨勢 ${new Date().getFullYear()}`,\n  `${theme} ${audience} 熱門話題`,\n  `${brand.brand_name || ''} 產業 最新消息`\n].filter(Boolean);\n\nreturn queries.map(q => ({ json: { query: q, brand } }));"
      },
      "id": "a2000001-0000-0000-0000-000000000005",
      "name": "組合搜尋關鍵字",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://google.serper.dev/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $env.SERPER_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ q: $json.query, gl: 'tw', hl: 'zh-TW', num: 10 }) }}",
        "options": {}
      },
      "id": "a2000001-0000-0000-0000-000000000006",
      "name": "Serper 搜尋",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 彙整所有搜尋結果\nconst allResults = [];\n\nfor (const item of $input.all()) {\n  const organic = item.json.organic || [];\n  for (const result of organic) {\n    allResults.push({\n      title: result.title,\n      link: result.link,\n      snippet: result.snippet || ''\n    });\n  }\n}\n\n// 去重（依 link）\nconst seen = new Set();\nconst unique = allResults.filter(r => {\n  if (seen.has(r.link)) return false;\n  seen.add(r.link);\n  return true;\n}).slice(0, 20);\n\nreturn [{\n  json: {\n    results: unique,\n    brand_id: $('驗證請求').first().json.brand_id,\n    count: unique.length\n  }\n}];"
      },
      "id": "a2000001-0000-0000-0000-000000000007",
      "name": "彙整搜尋結果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.GEMINI_MODEL || 'gemini-2.0-flash' }}:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  systemInstruction: { parts: [{ text: '你是社群媒體內容策略專家。根據品牌資訊和搜尋結果，評估每個主題的相關性。回傳 JSON 陣列，每個項目包含：topic_title（繁體中文標題）、source_url、relevance_score（0-100 整數）。只保留 relevance_score >= 60 的主題。直接回傳 JSON 陣列，不要用 markdown 包裹。' }] },\n  contents: [{ role: 'user', parts: [{ text: `品牌資訊：\\n品牌名稱：${$('讀取品牌資料').first().json.brand_name || ''}\\n主題：${$('讀取品牌資料').first().json.theme || ''}\\n目標受眾：${$('讀取品牌資料').first().json.target_audience || ''}\\n\\n搜尋結果：\\n${JSON.stringify($json.results.map(r => ({ title: r.title, url: r.link, snippet: r.snippet })))}` }] }],\n  generationConfig: { temperature: 0.3 }\n}) }}",
        "options": {
          "retry": {
            "maxTries": 3
          }
        }
      },
      "id": "a2000001-0000-0000-0000-000000000008",
      "name": "AI 評估相關性",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const brandId = $('驗證請求').first().json.brand_id;\nconst response = $input.first().json;\nconst content = response.candidates?.[0]?.content?.parts?.[0]?.text || '[]';\n\nlet topics;\ntry {\n  // 嘗試解析 JSON（可能被 markdown 包裹）\n  const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  topics = JSON.parse(cleaned);\n} catch (e) {\n  topics = [];\n}\n\nconst now = new Date().toISOString();\n\nreturn topics.map((t, i) => ({\n  json: {\n    topic_id: `topic-${Date.now()}-${i}`,\n    brand_id: brandId,\n    topic_title: t.topic_title || t.title || '',\n    source_url: t.source_url || t.url || '',\n    relevance_score: String(t.relevance_score || 0),\n    status: 'pending',\n    created_at: now\n  }\n}));"
      },
      "id": "a2000001-0000-0000-0000-000000000009",
      "name": "解析 AI 結果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
