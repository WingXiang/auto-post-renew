    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.GEMINI_MODEL || 'gemini-2.0-flash' }}:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  systemInstruction: { parts: [{ text: '你是潛在客戶分析師。根據社群互動內容，判斷每位互動者是否為潛在客戶，並建議下一步行動。回傳 JSON 陣列，每個項目包含：display_name、interaction_type、interaction_content、suggested_action。不要用 markdown 包裹。' }] },\n  contents: [{ role: 'user', parts: [{ text: `互動資料：\\n${JSON.stringify($json)}` }] }],\n  generationConfig: { temperature: 0.3 }\n}) }}",
        "options": {
          "retry": {
            "maxTries": 3
          }
        }
      },
      "id": "a7000001-0000-0000-0000-000000000010",
      "name": "AI 識別客戶",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const brandId = $('驗證請求').first().json.brand_id;\nconst response = $input.first().json;\nconst content = response.candidates?.[0]?.content?.parts?.[0]?.text || '[]';\n\nlet customers;\ntry {\n  const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  customers = JSON.parse(cleaned);\n} catch (e) {\n  customers = [];\n}\n\nconst now = new Date().toISOString();\n\nreturn customers.map((c, i) => ({\n  json: {\n    customer_id: `cust-${Date.now()}-${i}`,\n    brand_id: brandId,\n    display_name: c.display_name || '',\n    interaction_type: c.interaction_type || 'comment',\n    interaction_content: c.interaction_content || '',\n    post_id: c.post_id || '',\n    suggested_action: c.suggested_action || '',\n    status: 'new',\n    identified_at: now\n  }\n}));"
      },
