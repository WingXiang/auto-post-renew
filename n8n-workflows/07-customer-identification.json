    {
      "parameters": {
        "jsCode": "const brand = $('讀取品牌').first().json;\nconst posts = $('讀取貼文').all().map(i => i.json);\n\nif (!brand.meta_access_token) {\n  throw new Error('品牌尚未設定 Meta Access Token');\n}\n\n// 收集需要抓取留言的貼文\nconst targets = [];\nfor (const post of posts) {\n  if (post.fb_post_id) {\n    targets.push({\n      post_id: post.post_id,\n      platform_post_id: post.fb_post_id,\n      platform: 'facebook',\n      access_token: brand.meta_access_token\n    });\n  }\n  if (post.ig_post_id) {\n    targets.push({\n      post_id: post.post_id,\n      platform_post_id: post.ig_post_id,\n      platform: 'instagram',\n      access_token: brand.meta_access_token\n    });\n  }\n}\n\nreturn targets.map(t => ({ json: t }));"
      },
      "id": "a7000001-0000-0000-0000-000000000006",
      "name": "展開貼文",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.platform_post_id }}/comments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "from{id,name},message,created_time"
            },
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "access_token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a7000001-0000-0000-0000-000000000007",
      "name": "抓取留言",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const allComments = [];\n\nfor (const item of $input.all()) {\n  const comments = item.json.data || [];\n  const postId = $('展開貼文').all().find((_, idx) => idx === $input.all().indexOf(item))?.json?.post_id || '';\n  \n  for (const c of comments) {\n    allComments.push({\n      post_id: postId,\n      user_name: c.from?.name || '匿名',\n      user_id: c.from?.id || '',\n      message: c.message || '',\n      created_time: c.created_time || ''\n    });\n  }\n}\n\nif (allComments.length === 0) {\n  return [{ json: { no_comments: true, comments: [] } }];\n}\n\nreturn [{ json: { no_comments: false, comments: allComments } }];"
      },
      "id": "a7000001-0000-0000-0000-000000000008",
      "name": "彙整留言",
