        "jsCode": "const apiKey = $input.first().json.body.api_key;\nif (!apiKey || apiKey !== $env.N8N_API_KEY) {\n  throw new Error('Unauthorized');\n}\nconst { brand_id, brand_name } = $input.first().json.body;\n\nif (!brand_id || !brand_name) {\n  throw new Error('Missing required fields: brand_id, brand_name');\n}\n\nreturn [{\n  json: {\n    brand_id,\n    brand_name,\n    log_id: $now.toISO().replace(/[^0-9]/g, '').slice(0, 17),\n    started_at: $now.toISO()\n  }\n}];"
