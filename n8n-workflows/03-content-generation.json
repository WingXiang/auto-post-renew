    {
      "parameters": {
        "jsCode": "const brand = $('讀取品牌').first().json;\nconst topics = $('讀取已核准主題').all().map(i => i.json);\nconst optimization = $('讀取優化建議').first()?.json || {};\n\nif (topics.length === 0) {\n  throw new Error('沒有已核准的主題可用來生成貼文');\n}\n\nconst topicsText = topics.slice(0, 5).map((t, i) =>\n  `${i + 1}. ${t.topic_title}（來源：${t.source_url}）`\n).join('\\n');\n\nconst optimizationHint = optimization.caption_guidelines\n  ? `\\n\\n過去優化建議：\\n文案：${optimization.caption_guidelines}\\n圖片：${optimization.image_guidelines || '無'}`\n  : '';\n\nreturn [{\n  json: {\n    brand,\n    topics,\n    prompt: `你是社群媒體內容專家。請根據以下品牌資訊和主題，為每個主題生成 1 篇社群貼文。\\n\\n品牌名稱：${brand.brand_name}\\n品牌主題：${brand.theme}\\n風格：${brand.style || '專業且親切'}\\n語調：${brand.tone || '友善、專業'}\\n目標受眾：${brand.target_audience}\\n過去內容範例：${brand.past_content_samples || '無'}${optimizationHint}\\n\\n待生成主題：\\n${topicsText}\\n\\n請為每個主題回傳 JSON 陣列，每個項目包含：\\n- topic_id: 對應的主題 ID\\n- caption: 貼文文案（繁體中文，含 hashtag，150-300字）\\n- image_prompt: 用於 AI 生成配圖的英文提示詞（詳細描述風格、構圖、顏色）\\n- platform: \"both\"（預設同時發 FB 和 IG）\\n\\n直接回傳 JSON 陣列。`\n  }\n}];"
      },
      "id": "a3000001-0000-0000-0000-000000000006",
      "name": "準備 AI 提示",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
