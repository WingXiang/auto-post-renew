      "position": [900, 200],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets Account" }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "topics" },
        "filtersUI": { "values": [
          { "lookupColumn": "brand_id", "lookupValue": "={{ $('驗證請求').first().json.brand_id }}" },
          { "lookupColumn": "status", "lookupValue": "approved" }
        ]},
        "options": {}
      },
      "id": "a3000001-0000-0000-0000-000000000005",
      "name": "讀取已核准主題",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [900, 420],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets Account" }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "optimization_log" },
        "filtersUI": { "values": [{ "lookupColumn": "brand_id", "lookupValue": "={{ $('驗證請求').first().json.brand_id }}" }] },
        "options": { "returnAll": false, "limit": 1 }
      },
      "id": "a3000001-0000-0000-0000-000000000016",
      "name": "讀取優化建議",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [900, 600],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets Account" }
      }
    },
    {
      "parameters": {
        "jsCode": "const brand = $('讀取品牌').first().json;\nconst topics = $('讀取已核准主題').all().map(i => i.json);\nconst optimization = $('讀取優化建議').first()?.json || {};\n\nif (topics.length === 0) {\n  throw new Error('沒有已核准的主題可用來生成貼文');\n}\n\nconst topicsText = topics.slice(0, 5).map((t, i) =>\n  `${i + 1}. ${t.topic_title}（來源：${t.source_url}）`\n).join('\\n');\n\nconst optimizationHint = optimization.caption_guidelines\n  ? `\\n\\n過去優化建議：\\n文案：${optimization.caption_guidelines}\\n圖片：${optimization.image_guidelines || '無'}`\n  : '';\n\nreturn [{\n  json: {\n    brand,\n    topics,\n    prompt: `你是社群媒體內容專家。請根據以下品牌資訊和主題，為每個主題生成 1 篇社群貼文。\\n\\n品牌名稱：${brand.brand_name}\\n品牌主題：${brand.theme}\\n風格：${brand.style || '專業且親切'}\\n語調：${brand.tone || '友善、專業'}\\n目標受眾：${brand.target_audience}\\n過去內容範例：${brand.past_content_samples || '無'}${optimizationHint}\\n\\n待生成主題：\\n${topicsText}\\n\\n請為每個主題回傳 JSON 陣列，每個項目包含：\\n- topic_id: 對應的主題 ID\\n- caption: 貼文文案（繁體中文，含 hashtag，150-300字）\\n- image_prompt: 用於 AI 生成配圖的英文提示詞（詳細描述風格、構圖、顏色）\\n- platform: \"both\"（預設同時發 FB 和 IG）\\n\\n直接回傳 JSON 陣列。`\n  }\n}];"
      },
      "id": "a3000001-0000-0000-0000-000000000006",
      "name": "準備 AI 提示",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENAI_API_BASE || 'https://api.openai.com' }}/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENAI_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.OPENAI_MODEL || 'gpt-4o-mini',\n  messages: [\n    { role: 'system', content: '你是專業社群媒體內容創作者。只回傳 JSON 陣列，不要用 markdown 包裹。' },\n    { role: 'user', content: $json.prompt }\n  ],\n  temperature: 0.7,\n  max_tokens: 4000\n}) }}",
        "options": {}
      },
      "id": "a3000001-0000-0000-0000-000000000007",
      "name": "AI 生成貼文",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300]
    },
    {
      "parameters": {
        "jsCode": "const brandId = $('驗證請求').first().json.brand_id;\nconst response = $input.first().json;\nconst content = response.choices?.[0]?.message?.content || '[]';\n\nlet posts;\ntry {\n  const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  posts = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('AI 回傳格式解析失敗: ' + e.message);\n}\n\nconst now = new Date().toISOString();\n\nreturn posts.map((p, i) => ({\n  json: {\n    post_id: `post-${Date.now()}-${i}`,\n    brand_id: brandId,\n    topic_id: p.topic_id || '',\n    platform: p.platform || 'both',\n    caption: p.caption || '',\n    image_prompt: p.image_prompt || '',\n    image_url: '',\n    scheduled_time: '',\n    status: 'draft',\n    fb_post_id: '',\n    ig_post_id: '',\n    optimization_version: '0',\n    created_at: now\n  }\n}));"
      },
      "id": "a3000001-0000-0000-0000-000000000008",
      "name": "解析貼文",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "posts" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "post_id": "={{ $json.post_id }}",
            "brand_id": "={{ $json.brand_id }}",
            "topic_id": "={{ $json.topic_id }}",
            "platform": "={{ $json.platform }}",
            "caption": "={{ $json.caption }}",
            "image_prompt": "={{ $json.image_prompt }}",
            "image_url": "={{ $json.image_url }}",
            "scheduled_time": "={{ $json.scheduled_time }}",
            "status": "={{ $json.status }}",
            "fb_post_id": "",
            "ig_post_id": "",
            "optimization_version": "={{ $json.optimization_version }}",
            "created_at": "={{ $json.created_at }}"
          }
        },
        "options": {}
      },
      "id": "a3000001-0000-0000-0000-000000000009",
      "name": "寫入貼文",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1880, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets Account" }
      }
    },
    {
      "parameters": {
        "jsCode": "// 將已使用的主題標記為 used\nconst posts = $('解析貼文').all().map(i => i.json);\nconst topicIds = [...new Set(posts.map(p => p.topic_id).filter(Boolean))];\n\nreturn topicIds.map(id => ({ json: { topic_id: id, status: 'used' } }));"
      },
      "id": "a3000001-0000-0000-0000-000000000010",
      "name": "標記已用主題",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
