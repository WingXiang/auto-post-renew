      }
    },
    {
      "parameters": {
        "operation": "get",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "brands" },
        "filtersUI": { "values": [{ "lookupColumn": "brand_id", "lookupValue": "={{ $('驗證請求').first().json.brand_id }}" }] },
        "options": {}
