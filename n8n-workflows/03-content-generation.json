    {
      "parameters": {
        "jsCode": "const brandId = $('驗證請求').first().json.brand_id;\nconst response = $input.first().json;\nconst content = response.candidates?.[0]?.content?.parts?.[0]?.text || '[]';\n\nlet posts;\ntry {\n  const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  posts = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('AI 回傳格式解析失敗: ' + e.message);\n}\n\nconst now = new Date().toISOString();\n\nreturn posts.map((p, i) => ({\n  json: {\n    post_id: `post-${Date.now()}-${i}`,\n    brand_id: brandId,\n    topic_id: p.topic_id || '',\n    platform: p.platform || 'both',\n    caption: p.caption || '',\n    image_prompt: p.image_prompt || '',\n    image_url: '',\n    scheduled_time: '',\n    status: 'draft',\n    fb_post_id: '',\n    ig_post_id: '',\n    optimization_version: '0',\n    created_at: now\n  }\n}));"
      },
