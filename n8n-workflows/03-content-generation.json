        "sheetName": { "__rl": true, "mode": "list", "value": "pipeline_logs" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "log_id": "={{ $json.log_id }}",
            "brand_id": "={{ $json.brand_id }}",
            "workflow_name": "content-generation",
            "status": "running",
            "message": "AI 生成貼文內容中...",
            "started_at": "={{ $json.started_at }}",
            "finished_at": ""
          }
        },
        "options": {}
      },
